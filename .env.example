# =============================================================================
# University Attendance Management System — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# --- Database ---------------------------------------------------------------
# SQLite file. Use an absolute path in production and include it in backups.
DB_PATH=./.data/attendance.sqlite
# Optional alias: DATABASE_URL=sqlite:./.data/attendance.sqlite

# --- Initial administrator --------------------------------------------------
# Created automatically on first start when no super administrator exists.
# The password must be at least 12 characters and mix character classes.
# The account is forced to change this password at first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.edu
ADMIN_NAME=System Administrator

# --- Sessions & cookies -----------------------------------------------------
SESSION_TTL_HOURS=8
# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false
# Set to true when running behind a trusted reverse proxy.
TRUST_PROXY=false
# Allow the application to be embedded in a frame (e.g. a portal iframe).
# Leave false unless you really need it.
ALLOW_FRAMING=false

# --- Rate limiting ----------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
API_MAX_REQUESTS_PER_MINUTE=3000

# --- University identity (used in the UI, PDF and Excel exports) ------------
UNIVERSITY_NAME_EN=International University of Africa
UNIVERSITY_NAME_AR=جامعة أفريقيا العالمية
UNIVERSITY_SHORT_NAME=IUA
